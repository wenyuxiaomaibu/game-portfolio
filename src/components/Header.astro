---
const nav = [
  { href: '/', label: '首页' },
  { href: '/demos/', label: '游戏 Demo' },
  { href: '/teardowns/', label: '游戏拆解' },
  { href: '/cases/', label: '策划案例' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">游戏作品集</a>
    <nav class="site-nav" aria-label="主导航">
      {nav.map((item) => {
        const active = item.href === '/' ? path === '/' : path.startsWith(item.href);
        return (
          <a href={item.href} class:list={['nav-link', { active }]}>{item.label}</a>
        );
      })}
    </nav>
  </div>
</header>
