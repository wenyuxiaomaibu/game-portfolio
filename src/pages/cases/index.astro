---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/CaseCard.astro';
import { getCollection } from 'astro:content';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="策划案例" description="我的游戏策划案例文档，提供 PDF 下载。">
  <h1 class="page-title">策划案例</h1>
  <p class="lead">我的游戏策划案例文档，点击下载 PDF 查看完整内容。</p>

  <div class="grid" style="margin-top: 32px;">
    {cases.map((c) => (
      <CaseCard
        title={c.data.title}
        summary={c.data.summary}
        pdf={c.data.pdf}
        tags={c.data.tags}
      />
    ))}
  </div>
</BaseLayout>
