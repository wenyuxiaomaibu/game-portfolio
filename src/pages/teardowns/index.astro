---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeardownCard from '../../components/TeardownCard.astro';
import { getCollection } from 'astro:content';

const teardowns = (await getCollection('teardowns')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="游戏拆解" description="我对已有游戏做的系统拆解与分析。">
  <h1 class="page-title">游戏拆解</h1>
  <p class="lead">我对已有游戏做的系统拆解与分析。</p>

  <div class="grid" style="margin-top: 32px;">
    {teardowns.map((t) => (
      <TeardownCard
        href={`/teardowns/${t.id}/`}
        title={t.data.title}
        game={t.data.game}
        date={t.data.date}
        tags={t.data.tags}
      />
    ))}
  </div>
</BaseLayout>
